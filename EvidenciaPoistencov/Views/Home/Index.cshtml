@{
    ViewData["Title"] = "Domov";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">Evidencia poistencov</h1>

    <p class="lead mt-3">Webová aplikácia na správu poistencov a ich poistení.</p>

    @if (User.Identity?.IsAuthenticated != true)    
    {
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg mt-3">Prihlásiť sa</a>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Poistenci" asp-action="Index" class="btn btn-primary btn-lg">Poistenci</a>

            <a asp-controller="Poistenia" asp-action="Index" class="btn btn-outline-primary btn-lg">Poistenia</a>
        </div>
    }
    @if (User.IsInRole("Poistenec"))
    {
        <div class="mt-4">
            <a asp-controller="UdajePoistenca" asp-action="Index" class="btn btn-primary btn-lg">Moje údaje</a>
        </div>
    }
</div>