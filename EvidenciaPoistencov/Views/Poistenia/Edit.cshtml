@model EvidenciaPoistencov.Models.Poistenie

@{
    ViewData["Title"] = "Upraviť poistenie";
}

<h1>Upraviť poistenie</h1>

<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly"class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nazov" class="form-label"></label>
                <input asp-for="Nazov" class="form-control" />
                <span asp-validation-for="Nazov" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PredmetPoistenia" class="form-label"></label>
                <input asp-for="PredmetPoistenia" class="form-control" />
                <span asp-validation-for="PredmetPoistenia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Suma" class="form-label"></label>
                <input asp-for="Suma" class="form-control" />
                <span asp-validation-for="Suma" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlatnostOd" class="form-label"></label>
                <input asp-for="PlatnostOd" class="form-control" />
                <span asp-validation-for="PlatnostOd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlatnostDo" class="form-label"></label>
                <input asp-for="PlatnostDo" class="form-control" />
                <span asp-validation-for="PlatnostDo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Poistenec</label>

                <div class="form-control bg-light">
                    @if (Model.Poistenec != null)
                    {
                        <span>
                            @Model.Poistenec.Meno @Model.Poistenec.Priezvisko — @Model.Poistenec.Email
                            @if (!string.IsNullOrWhiteSpace(Model.Poistenec.Mesto))
                            {
                                <text> — @Model.Poistenec.Mesto</text>
                            }
                        </span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Uložiť</button>
                <a asp-action="Index" class="btn btn-secondary">Späť na zoznam</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}