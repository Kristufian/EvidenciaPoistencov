@model EvidenciaPoistencov.Models.Poistenie

@{
    ViewData["Title"] = "Vytvoriť nové poistenie";
}

<h1>Vytvoriť nové poistenie</h1>

<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Nazov" class="form-label"></label>
                <input asp-for="Nazov" class="form-control" />
                <span asp-validation-for="Nazov" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PredmetPoistenia" class="form-label"></label>
                <input asp-for="PredmetPoistenia" class="form-control" />
                <span asp-validation-for="PredmetPoistenia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Suma" class="form-label"></label>
                <input asp-for="Suma" class="form-control" />
                <span asp-validation-for="Suma" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlatnostOd" class="form-label"></label>
                <input asp-for="PlatnostOd" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="PlatnostOd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlatnostDo" class="form-label"></label>
                <input asp-for="PlatnostDo" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="PlatnostDo" class="text-danger"></span>
            </div>

            <div class="mb-3 position-relative">
                <label for="poistenecSearch" class="form-label">Poistenec</label>

                <input type="text" id="poistenecSearch" class="form-control" placeholder="Začni písať meno, priezvisko alebo email..."
                       autocomplete="off" value="@ViewData["SelectedPoistenecText"]" />

                <input asp-for="PoistenecId" type="hidden" />

                <span asp-validation-for="PoistenecId" class="text-danger"></span>

                <div id="poistenecResults" class="list-group position-absolute w-100 shadow" style="z-index: 1000;"></div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Vytvoriť</button>
                <a asp-action="Index" class="btn btn-secondary">Späť na zoznam</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const searchInput = document.getElementById("poistenecSearch");
        const poistenecIdInput = document.getElementById("PoistenecId");
        const resultsContainer = document.getElementById("poistenecResults");

        searchInput.addEventListener("input", async function () {
               const term = this.value.trim();

               poistenecIdInput.value = "";
               resultsContainer.innerHTML = "";

               if (term.length < 2) {
                      return;
               }

               const response = await fetch('@Url.Action("SearchPoistenci", "Poistenia")' + '?term=' + encodeURIComponent(term));

               const poistenci = await response.json();

               poistenci.forEach(poistenec => {
                      const item = document.createElement("button");

                      item.type = "button";
                      item.className = "list-group-item list-group-item-action";
                  item.textContent = poistenec.text;

                         item.addEventListener("click", function () {
                             searchInput.value = poistenec.text;
                             poistenecIdInput.value = poistenec.id;
                          resultsContainer.innerHTML = "";
                  });

                   resultsContainer.appendChild(item);
            });
         });
    </script>
}