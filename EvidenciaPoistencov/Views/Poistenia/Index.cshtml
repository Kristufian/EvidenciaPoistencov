@model IEnumerable<EvidenciaPoistencov.Models.Poistenie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Vytvoriť nové poistenie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nazov)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PredmetPoistenia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Suma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlatnostOd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlatnostDo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Poistenec)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nazov)
            </td>
            <td>
                @Html.DisplayFor(model => item.PredmetPoistenia)
            </td>
            <td>
                @Html.DisplayFor(model => item.Suma)
            </td>
            <td>
                @Html.DisplayFor(model => item.PlatnostOd)
            </td>
            <td>
                @Html.DisplayFor(model => item.PlatnostDo)
            </td>
            <td>
                @($"{item.Poistenec?.Meno} {item.Poistenec?.Priezvisko}")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Upraviť</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detaily</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Vymazať</a>
            </td>
        </tr>
}
    </tbody>
</table>
