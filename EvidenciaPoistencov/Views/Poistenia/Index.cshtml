@model IEnumerable<EvidenciaPoistencov.Models.Poistenie>

@{
	ViewData["Title"] = "Poistenia";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
	<h1>Poistenia</h1>

	<a asp-action="Create" class="btn btn-primary">Vytvoriť nové poistenie</a>
</div>

<div class="table-responsive">
	<table class="table table-striped align-middle">
		<thead>
			<tr>
				<th>Názov</th>
				<th>Predmet poistenia</th>
				<th>Poistná suma</th>
				<th>Platnosť od</th>
				<th>Platnosť do</th>
				<th>Poistenec</th>
				<th>Akcie</th>
			</tr>
		</thead>

		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@item.Nazov
					</td>
					<td>
						@(item.PredmetPoistenia ?? "—")
					</td>
					<td>
						@(item.Suma == decimal.Truncate(item.Suma) ? $"{item.Suma:N0} €" : $"{item.Suma:N2} €")
					</td>
					<td>
						@item.PlatnostOd.ToShortDateString()
					</td>
					<td>
						@(item.PlatnostDo?.ToShortDateString() ?? "—")
					</td>
					<td>
						@if (item.Poistenec != null)
						{
							@($"{item.Poistenec.Meno} {item.Poistenec.Priezvisko}")
						}
						else
						{
							<span>—</span>
						}
					</td>
					<td>
						<div class="d-flex gap-1 flex-wrap">
							<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detaily</a>

							<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Upraviť</a>

							<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Vymazať</a>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>