@model EvidenciaPoistencov.Models.Poistenie

@{
    ViewData["Title"] = "Vymazanie poistenia";
}

<h1>Vymazanie poistenia</h1>

<div class="alert alert-danger" role="alert"><strong>Upozornenie: </strong>Túto akciu nie je možné vrátiť späť</div>

<h3>Ste si istý, že chcete vymazať toto poistenie?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nazov)</dt>
    <dd class="col-sm-9">@Model.Nazov</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PredmetPoistenia)</dt>
    <dd class="col-sm-9">@(Model.PredmetPoistenia ?? "—")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Suma)</dt>
    <dd class="col-sm-9">@(Model.Suma == decimal.Truncate(Model.Suma) ? $"{Model.Suma:N0} €" : $"{Model.Suma:N2} €")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PlatnostOd)</dt>
    <dd class="col-sm-9">@Model.PlatnostOd.ToShortDateString()</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PlatnostDo)</dt>
    <dd class="col-sm-9">@(Model.PlatnostDo?.ToShortDateString() ?? "—")</dd>

    <dt class="col-sm-3">Poistenec</dt>
    <dd class="col-sm-9">
        @if (Model.Poistenec != null)
        {
            <span>@Model.Poistenec.Meno @Model.Poistenec.Priezvisko</span>
        }
        else
        {
            <span>—</span>
        }
    </dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="d-flex gap-2 flex-wrap"><button type="submit" class="btn btn-danger">Vymazať</button>

        <a asp-action="Index" class="btn btn-secondary">Späť na zoznam</a>
    </div>
</form>