@using Microsoft.AspNetCore.Identity
@using EvidenciaPoistencov.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <form method="post" form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                <button type="submit" class="nav-link btn btn-link text-dark">Odhlásenie</button>
            </form>
        </li>
    }
</ul>