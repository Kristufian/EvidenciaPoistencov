@model EvidenciaPoistencov.Models.Poistenec

@{
    ViewData["Title"] = "Moje údaje";
}

<h1>Moje údaje</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4>@Model.Meno @Model.Priezvisko</h4>

        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Telefón:</strong> @Model.Telefon</p>
        <p><strong>Ulica:</strong> @Model.Ulica</p>
        <p><strong>Mesto:</strong> @Model.Mesto</p>
        <p><strong>PSČ:</strong> @Model.PSC</p>
    </div>
</div>

<h2>Moje poistenia</h2>

@if (Model.Poistenia != null && Model.Poistenia.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Názov</th>
                <th>Predmet poistenia</th>
                <th>Poistná suma</th>
                <th>Platnosť od</th>
                <th>Platnosť do</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var poistenie in Model.Poistenia)
            {
                <tr>
                    <td>@poistenie.Nazov</td>
                    <td>@poistenie.PredmetPoistenia</td>
                    <td>@poistenie.Suma €</td>
                    <td>@poistenie.PlatnostOd.ToShortDateString()</td>
                    <td>@poistenie.PlatnostDo.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Zatiaľ nemáte žiadne poistenia.</p>
}