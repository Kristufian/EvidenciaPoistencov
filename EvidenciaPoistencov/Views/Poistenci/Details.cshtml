@model EvidenciaPoistencov.Models.Poistenec

@{
    ViewData["Title"] = "Detaily poistenca";
}

<h1>Detaily poistenca</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Meno)</dt>
    <dd class="col-sm-9">@Model.Meno</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Priezvisko)</dt>
    <dd class="col-sm-9">@Model.Priezvisko</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefon)</dt>
    <dd class="col-sm-9">@(Model.Telefon ?? "—")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Ulica)</dt>
    <dd class="col-sm-9">@(Model.Ulica ?? "—")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Mesto)</dt>
    <dd class="col-sm-9">@(Model.Mesto ?? "—")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PSC)</dt>
    <dd class="col-sm-9">@(Model.PSC ?? "—")</dd>
</dl>

<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Upraviť</a>
    <a asp-action="Index" class="btn btn-secondary">Späť na zoznam</a>
</div>

<hr />

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Poistenia</h2>

    <a asp-controller="Poistenia" asp-action="Create" asp-route-poistenecId="@Model.Id" class="btn btn-primary">Pridať poistenie</a>
</div>

@if (Model.Poistenia.Any())
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Názov</th>
                    <th>Predmet poistenia</th>
                    <th>Poistná suma</th>
                    <th>Platnosť od</th>
                    <th>Platnosť do</th>
                    <th>Akcie</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var poistenie in Model.Poistenia)
                {
                    <tr>
                        <td>@poistenie.Nazov</td>
                        <td>@(poistenie.PredmetPoistenia ?? "—")</td>
                        <td>@(poistenie.Suma == decimal.Truncate(poistenie.Suma) ? $"{poistenie.Suma:N0} €" : $"{poistenie.Suma:N2} €")</td>
                        <td>@poistenie.PlatnostOd.ToShortDateString()</td>
                        <td>@poistenie.PlatnostDo?.ToShortDateString()</td>
                        <td><a asp-controller="Poistenia" asp-action="Details" asp-route-id="@poistenie.Id" class="btn btn-sm btn-info">Detail</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">Poistenec zatiaľ nemá žiadne poistenie.</p>
}