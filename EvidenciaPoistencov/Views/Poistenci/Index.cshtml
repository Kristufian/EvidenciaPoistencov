@model IEnumerable<EvidenciaPoistencov.Models.Poistenec>

@{
    ViewData["Title"] = "Poistenci";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1>Poistenci</h1>

    <a asp-action="Create" class="btn btn-primary">Vytvoriť nového poistenca</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Meno a priezvisko</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Telefon)</th>
                <th>@Html.DisplayNameFor(model => model.Mesto)</th>
                <th>Akcie</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Meno @item.Priezvisko</td>

                    <td>@item.Email</td>

                    <td>@item.Telefon</td>

                    <td>@item.Mesto</td>

                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detaily</a>

                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Upraviť</a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Vymazať</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>